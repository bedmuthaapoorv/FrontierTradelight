# Environment / secrets
.env
.env.*
!.env.template

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/

# OS files
.DS_Store
Thumbs.db

# Editor / agent tooling
.claude/
.agents/
.idea/

# Generated data / logs - all runtime output lives in Strategies/Default/data/.
# Most of it is regenerable (backtest caches, screener/sell reports, logs,
# near-misses, API caches) and stays ignored, but a few files are the ONLY
# copy of real data with no other source of truth - the Stats tab's
# leaderboard, the personal Holdings/Sell tab's positions, and the whole
# Fund Manager ledger (investors, capital events, NAV history, fund
# holdings, cash, NAV generation marker) - so those are explicitly kept.
Strategies/Default/data/*
!Strategies/Default/data/strategy_stats.csv
!Strategies/Default/data/holdings.csv
!Strategies/Default/data/fund
# Point-in-time Nifty 500 membership (historical_universe.py) - archived
# snapshots can't be regenerated if the source disappears, so keep them.
!Strategies/Default/data/universe_history
Strategies/universe_cache.json
# US market (Strategies/US) - same split as Default above. No fund ledger
# on the US side, so only the Stats leaderboard and Holdings are kept.
Strategies/US/data/*
!Strategies/US/data/strategy_stats.csv
!Strategies/US/data/holdings.csv

# Strategy rule docs
rules.md
exit_rules.md
generated_rules.py

# Common Method Library write lock (Strategies/Default/common_methods/)
.lock
